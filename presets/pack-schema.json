{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/X-Zero-L/relink-save-forge/raw/main/presets/pack-schema.json",
  "title": "Relink Save Forge preset pack",
  "type": "object",
  "required": ["schema_version", "id", "name", "description", "steps"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "invariants": {
      "type": "object",
      "properties": {
        "preserve_header": { "type": "boolean" },
        "preserve_payload_size": { "type": "boolean" },
        "preserve_record_count": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "command"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "name": { "type": "string" },
          "kind": { "type": "string", "enum": ["transform", "verify"] },
          "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
          "audit_required": { "type": "boolean" },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "env": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
