{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gbfr-relink-2.0-preset.schema.json",
  "title": "GBFR Relink character sigil preset",
  "type": "object",
  "required": ["schemaVersion", "gameDataVersion", "character", "scope", "sigils", "evidence"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "gameDataVersion": { "type": "string" },
    "character": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^PL[0-9A-Z]{4}$" },
        "name": { "type": "string" }
      },
      "additionalProperties": false
    },
    "scope": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "sigils": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["slot", "primary", "secondary", "level"],
        "properties": {
          "slot": { "type": "integer", "minimum": 1, "maximum": 12 },
          "primary": { "$ref": "#/$defs/trait" },
          "secondary": { "$ref": "#/$defs/trait" },
          "level": { "type": "integer", "minimum": 1, "maximum": 15 },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "evidence": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  },
  "$defs": {
    "trait": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

