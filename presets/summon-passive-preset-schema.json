{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/X-Zero-L/relink-save-forge/raw/main/presets/summon-passive-preset-schema.json",
  "title": "Relink Save Forge equipped-summon passive preset",
  "type": "object",
  "required": ["schema_version", "id", "game_data_version", "summons", "source"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "id": { "type": "string" },
    "name": { "type": "string" },
    "name_zh": { "type": "string" },
    "game_data_version": { "type": "string", "const": "Relink 2.0.2" },
    "description": { "type": "string" },
    "summons": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "name",
          "summon_hash",
          "skill_lot",
          "summon_curve",
          "trait_id",
          "trait_hash",
          "trait_name",
          "trait_name_zh",
          "trait_level",
          "preserve_bonus"
        ],
        "properties": {
          "name": { "type": "string" },
          "summon_hash": { "type": "string", "pattern": "^[0-9A-F]{8}$" },
          "skill_lot": { "type": "string", "pattern": "^[0-9A-F]{8}$" },
          "summon_curve": { "type": "string", "pattern": "^[0-9A-F]{8}$" },
          "trait_id": { "type": "string", "pattern": "^SKILL_[0-9]{3}_[0-9]{2}$" },
          "trait_hash": { "type": "string", "pattern": "^[0-9A-F]{8}$" },
          "trait_name": { "type": "string" },
          "trait_name_zh": { "type": "string" },
          "trait_level": { "type": "integer", "const": 15 },
          "preserve_bonus": { "type": "boolean", "const": true }
        },
        "additionalProperties": false
      }
    },
    "source": { "type": "object" }
  },
  "additionalProperties": false
}
