{
  "schema_version": 1,
  "id": "standard-endgame-qol",
  "name": "Standard Lv15 Survival/QoL (Existing Inventory)",
  "description": "Use only existing equipped instances. Apply the database-row-backed level-15 survival/QoL sigils, a level-15 Cascade/Nimble Onslaught/Greater Aegis weapon blessing, and the existing top-four summon passives.",
  "invariants": {
    "preserve_header": true,
    "preserve_payload_size": true,
    "preserve_record_count": true
  },
  "steps": [
    {
      "id": "standard-qol-sigils",
      "name": "Apply legal level-15 survival/QoL sigils",
      "kind": "transform",
      "timeout_seconds": 1800,
      "audit_required": true,
      "command": [
        "{python}",
        "{root}/scripts/equip_standard_sigil_preset.py",
        "{input}",
        "{output}",
        "--characters",
        "{root}/catalogs/characters.json",
        "--preset",
        "{root}/presets/sigils/standard-endgame-qol-2.0.2.json",
        "--pair-catalog",
        "{root}/catalogs/sigil-legal-pairs-2.0.2.json",
        "--cap-catalog",
        "{root}/catalogs/skill-level-caps-2.0.2.json",
        "--expected-preset-sha256",
        "21C44DD33A62D2EEF830FF702B6B78E87EB67A6D82ED290BED552CAFB3BEAAAA",
        "--expected-build-sha256",
        "FA2D287AA04C1D0E41744E868DC62706A4C485AFD753EF879AE0E31AC31F18D9",
        "--audit",
        "{audit}",
        "--editor-root",
        "{editor_root}"
      ]
    },
    {
      "id": "standard-qol-weapon-blessing",
      "name": "Apply legal level-15 survival weapon blessing",
      "kind": "transform",
      "timeout_seconds": 1800,
      "audit_required": true,
      "command": [
        "{python}",
        "{root}/scripts/equip_verified_weapon_blessings.py",
        "{input}",
        "{output}",
        "--characters",
        "{root}/catalogs/characters.json",
        "--preset",
        "{root}/presets/weapons/endgame-survival-blessing-standard-2.0.2.json",
        "--expected-preset-sha256",
        "29EC397191280452B5E78EB1880C803313AC775B5FA9965AF4115EABE4BC2DBF",
        "--audit",
        "{audit}",
        "--editor-root",
        "{editor_root}"
      ]
    },
    {
      "id": "standard-qol-summon-passives",
      "name": "Apply existing top-four summon passives",
      "kind": "transform",
      "timeout_seconds": 1800,
      "audit_required": true,
      "command": [
        "{python}",
        "{root}/scripts/equip_verified_summon_traits.py",
        "{input}",
        "{output}",
        "--preset",
        "{root}/presets/summons/endgame-qol-passives-2.0.2.json",
        "--expected-preset-sha256",
        "41FDBB2CAF0263C0534EC5F13A66DBC4BDBE9DB74AAD84DF1AB7D425AF114C5F",
        "--audit",
        "{audit}",
        "--editor-root",
        "{editor_root}"
      ]
    }
  ]
}
