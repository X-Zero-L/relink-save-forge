{
  "schema_version": 1,
  "id": "latest-endgame-gold",
  "name": "Gold Lv99 Endgame (Existing Inventory)",
  "description": "Explicit modifier preset for existing equipped instances: 24 unique level-99 sigil traits per character, three level-99 equipped-weapon blessing traits, and four legal max-level global summon passives. It does not create missing weapons or summons and does not change story progress.",
  "invariants": {
    "preserve_header": true,
    "preserve_payload_size": true,
    "preserve_record_count": true
  },
  "steps": [
    {
      "id": "latest-endgame-gold",
      "name": "Apply latest endgame gold sigils",
      "kind": "transform",
      "timeout_seconds": 1800,
      "audit_required": true,
      "command": [
        "{python}",
        "{root}/scripts/equip_latest_endgame_gold_sigils.py",
        "{input}",
        "{output}",
        "--characters",
        "{root}/catalogs/characters.json",
        "--preset",
        "{root}/presets/sigils/latest-endgame-gold-2.0.2.json",
        "--audit",
        "{audit}",
        "--expected-build-sha256",
        "CD07EA5ECC868137F1B97B2FF95A74974CFC861D769569FEE122BE45CBF866BB",
        "--editor-root",
        "{editor_root}"
      ]
    },
    {
      "id": "endgame-qol-weapon-blessing",
      "name": "Apply equipped-weapon QoL blessing",
      "kind": "transform",
      "timeout_seconds": 1800,
      "audit_required": true,
      "command": [
        "{python}",
        "{root}/scripts/equip_verified_weapon_blessings.py",
        "{input}",
        "{output}",
        "--characters",
        "{root}/catalogs/characters.json",
        "--preset",
        "{root}/presets/weapons/endgame-qol-blessing-2.0.2.json",
        "--expected-preset-sha256",
        "BD522C3F97FECF31275AFA65C31B9FA6ED46104B706C91D816ED2AEDCBE48840",
        "--audit",
        "{audit}",
        "--editor-root",
        "{editor_root}"
      ]
    },
    {
      "id": "endgame-qol-summon-passives",
      "name": "Apply top-four summon passives",
      "kind": "transform",
      "timeout_seconds": 1800,
      "audit_required": true,
      "command": [
        "{python}",
        "{root}/scripts/equip_verified_summon_traits.py",
        "{input}",
        "{output}",
        "--preset",
        "{root}/presets/summons/gold-endgame-qol-passives-2.0.2.json",
        "--expected-preset-sha256",
        "2A0F8BA0D4579FD46608E7CA7F0A1DDF8726E3253EBDFD05C7C377272CE27BEE",
        "--audit",
        "{audit}",
        "--editor-root",
        "{editor_root}"
      ]
    }
  ]
}
