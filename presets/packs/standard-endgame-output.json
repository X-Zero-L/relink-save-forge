{
  "schema_version": 1,
  "id": "standard-endgame-output",
  "name": "Standard Lv15 Output (Existing Inventory)",
  "description": "Use only existing equipped instances. Apply the database-row-backed level-15 output sigils, a level-15 Quick Cooldown/Cascade/Stout Heart weapon blessing, and the existing top-four summon passives.",
  "invariants": {
    "preserve_header": true,
    "preserve_payload_size": true,
    "preserve_record_count": true
  },
  "steps": [
    {
      "id": "standard-output-sigils",
      "name": "Apply legal level-15 output sigils",
      "kind": "transform",
      "timeout_seconds": 1800,
      "audit_required": true,
      "command": [
        "{python}",
        "{root}/scripts/equip_standard_sigil_preset.py",
        "{input}",
        "{output}",
        "--characters",
        "{root}/catalogs/characters.json",
        "--preset",
        "{root}/presets/sigils/standard-endgame-output-2.0.2.json",
        "--pair-catalog",
        "{root}/catalogs/sigil-legal-pairs-2.0.2.json",
        "--cap-catalog",
        "{root}/catalogs/skill-level-caps-2.0.2.json",
        "--expected-preset-sha256",
        "F4CDF09C1DB1A4337194B6B855BC51D77577DA3C8F2FABED674EBB7FF4978790",
        "--expected-build-sha256",
        "6994C5F95EE5AD6AC188A0138E7BFD66AE80E06B41F912038D5342394813F7D4",
        "--audit",
        "{audit}",
        "--editor-root",
        "{editor_root}"
      ]
    },
    {
      "id": "standard-output-weapon-blessing",
      "name": "Apply legal level-15 output weapon blessing",
      "kind": "transform",
      "timeout_seconds": 1800,
      "audit_required": true,
      "command": [
        "{python}",
        "{root}/scripts/equip_verified_weapon_blessings.py",
        "{input}",
        "{output}",
        "--characters",
        "{root}/catalogs/characters.json",
        "--preset",
        "{root}/presets/weapons/endgame-qol-blessing-standard-2.0.2.json",
        "--expected-preset-sha256",
        "3D7ED4731076222C0646B204A78017F80D7AD646E4628BAF701EB29A4EAD763B",
        "--audit",
        "{audit}",
        "--editor-root",
        "{editor_root}"
      ]
    },
    {
      "id": "standard-output-summon-passives",
      "name": "Apply existing top-four summon passives",
      "kind": "transform",
      "timeout_seconds": 1800,
      "audit_required": true,
      "command": [
        "{python}",
        "{root}/scripts/equip_verified_summon_traits.py",
        "{input}",
        "{output}",
        "--preset",
        "{root}/presets/summons/endgame-qol-passives-2.0.2.json",
        "--expected-preset-sha256",
        "41FDBB2CAF0263C0534EC5F13A66DBC4BDBE9DB74AAD84DF1AB7D425AF114C5F",
        "--audit",
        "{audit}",
        "--editor-root",
        "{editor_root}"
      ]
    }
  ]
}
